# Copy this file to config.env and fill in values.
# config.env is gitignored. Do not commit real keys.

# --- OpenAI (optional; leave empty to use heuristic parser only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override only if you use a compatible proxy / Azure-style base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Geocoding (reserved; not required for local gazetteer) ---
GEOCODER_PROVIDER=local
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# GOOGLE_MAPS_API_KEY=

# --- Output ---
OUTPUT_DIR=output
DEFAULT_BBOX_HALF_DEG=0.008
